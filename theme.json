{
  "name": "锦鲤池塘 · Pond",
  "short": "monitor-pond",
  "description": "水静，鱼游。以字符锦鲤与留白构成的池畔监控页。",
  "version": "1.3.0",
  "author": "ayingQAQ",
  "url": "https://github.com/ayingQAQ/monitor-ascii-pond",
  "config": [
    {
      "key": "notice",
      "type": "text",
      "label": "公告",
      "default": ""
    },
    {
      "key": "hero_eyebrow",
      "type": "string",
      "label": "首页小标题",
      "help": "主标题上方的文字，留空隐藏。",
      "default": ""
    },
    {
      "key": "hero_title",
      "type": "string",
      "label": "首页标题",
      "help": "留空隐藏。",
      "default": ""
    },
    {
      "key": "hero_subtitle",
      "type": "string",
      "label": "首页副标题",
      "help": "主标题下方的文字，留空隐藏。",
      "default": ""
    },
    {
      "key": "color_mode",
      "type": "select",
      "label": "默认背景色",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "跟随系统"
        },
        {
          "value": "light",
          "label": "纸白（浅色）"
        },
        {
          "value": "dark",
          "label": "暖黑（深色）"
        }
      ]
    },
    {
      "key": "display_mode",
      "type": "select",
      "label": "默认显示模式",
      "default": "ambient",
      "options": [
        {
          "value": "garden",
          "label": "分栏模式（右侧场景）"
        },
        {
          "value": "ambient",
          "label": "全屏背景模式"
        }
      ]
    },
    {
      "key": "scene",
      "type": "select",
      "label": "背景场景",
      "default": "forest",
      "options": [
        {
          "value": "forest",
          "label": "像素森林"
        },
        {
          "value": "pond",
          "label": "锦鲤池塘"
        }
      ]
    },
    {
      "key": "pond_enabled",
      "type": "boolean",
      "label": "显示背景动画",
      "default": true
    },
    {
      "key": "feeding_enabled",
      "type": "boolean",
      "label": "允许点击互动（投喂 / 起风）",
      "default": true
    },
    {
      "key": "show_expiry",
      "type": "boolean",
      "label": "显示到期信息",
      "default": true
    }
  ]
}
